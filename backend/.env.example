# PostgreSQL Database Connection URL (Mandatory)
# Example local: postgresql://username:password@localhost:5432/ikigai_db
# Example Neon/Supabase/Railway: postgresql://user:pass@ep-xyz.aws.neon.tech/ikigai_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ikigai_db"

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET="ikigai_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Optional AI Assistant API Key (if connected to OpenAI/Anthropic/Gemini)
AI_API_KEY=""
